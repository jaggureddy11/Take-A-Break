datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String    @id @default(uuid())
  phone      String    @unique
  name       String?
  role       String    // "SEEKER" or "DUDE" or "ADMIN"
  otp        String?
  otpExpiry  DateTime?
  createdAt  DateTime  @default(now())
  
  // Relations
  bountiesAsSeeker Bounty[] @relation("BountiesAsSeeker")
  bountiesAsDude   Bounty[] @relation("BountiesAsDude")
  bankDetails      BankDetails?
  transactions     Transaction[]
  disputesRaised   Dispute[]            @relation("DisputesRaised")
  reviewsGiven     Review[]             @relation("ReviewsGiven")
  reviewsReceived  Review[]             @relation("ReviewsReceived")
}

model Bounty {
  id           String              @id // e.g. "B-8831" or custom ID
  area         String
  locationName String
  lat          Float
  lng          Float
  budgetMin    Int
  budgetMax    Int
  depositMin   Int
  depositMax   Int
  roomType     String
  genderPref   String              @default("Any")
  foodPref     String?
  preferences  String[]            // Native Postgres array
  notes        String              @db.Text
  status       String              @default("pending") // pending, visiting, submitted, completed, disputed
  seekerId     String
  seekerName   String
  dudeId       String?
  dudeName     String?
  escrowState  String              @default("secured") // secured, released, disputed
  createdAt    DateTime            @default(now())
  bountyType   String              @default("scouting") // scouting, verification
  targetLink   String?
  payoutAmount Int                 @default(400)
  escrowAmount Int                 @default(499)

  // Relations
  seeker       User                @relation("BountiesAsSeeker", fields: [seekerId], references: [id])
  dude         User?               @relation("BountiesAsDude", fields: [dudeId], references: [id])
  report       VerificationReport?
  chat         ChatMessage[]
  transactions Transaction[]
  dispute      Dispute?
  reviews      Review[]
}

model VerificationReport {
  id         String   @id @default(uuid())
  bountyId   String   @unique
  wifiSpeed  Int
  foodRating String
  photo      String
  location   String
  createdAt  DateTime @default(now())

  // Relations
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  bountyId  String
  sender    String   // "seeker" or "dude"
  text      String   @db.Text
  time      String   // formatted time string, e.g. "10:35 AM"
  createdAt DateTime @default(now())

  // Relations
  bounty    Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
}

model BankDetails {
  id        String   @id @default(uuid())
  userId    String   @unique
  upiId     String?
  accountNo String?
  ifscCode  String?
  bankName  String?
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  bountyId    String
  userId      String
  amount      Int
  type        String   // "DEPOSIT" | "PAYOUT" | "FEE" | "REFUND"
  status      String   // "PENDING" | "SUCCESS" | "FAILED"
  razorpayId  String?
  createdAt   DateTime @default(now())

  // Relations
  bounty      Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id              String    @id @default(uuid())
  bountyId        String    @unique
  raisedById      String
  reason          String
  status          String    @default("OPEN") // "OPEN" | "RESOLVED" | "CANCELLED"
  resolutionNotes String?   @db.Text
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  bounty          Bounty    @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  raisedBy        User      @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(uuid())
  bountyId    String
  reviewerId  String
  revieweeId  String
  rating      Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  bounty      Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
}
